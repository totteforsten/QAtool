# Optional: lock down the /api/* endpoints. If unset, the API is open.
# Clients must send it as: `x-qatool-key: <value>` (or `Authorization: Bearer <value>`).
QATOOL_API_KEY=

# Optional: custom user agent sent to target sites (fast scan + link checker).
QATOOL_USER_AGENT="Mozilla/5.0 (compatible; QAtoolBot/0.1)"

# Optional: local Chrome/Chromium path for Puppeteer (deep scan / screenshots)
# when running outside Vercel/Lambda. Ignored in production.
# QATOOL_CHROME_EXECUTABLE=/usr/bin/google-chrome-stable

# Optional: WebSocket endpoint for a remote headless browser service
# (e.g. browserless). Highest priority when set.
# QATOOL_BROWSER_WS=wss://chrome.example.com?token=...

# Optional: force a specific launch strategy. Default "auto".
# Values: auto | lambda | local-chrome | local-puppeteer | remote
# QATOOL_BROWSER_MODE=local-puppeteer
